#!/usr/bin/env python3
"""On-demand camera feed for v4l2loopback (PipeWire-compatible).

Uses v4l2sink for both idle and camera modes so PipeWire's SPA V4L2 plugin
can properly stream from the loopback device (raw os.write() causes PipeWire
to crash with SIGSEGV).

Idle: videotestsrc pattern=black → v4l2sink (0% CPU, LED off)
Active: icamerasrc → videoflip → v4l2sink (real camera, LED on)

Starts/stops the real camera based on fuser detecting readers on /dev/video50.
"""

import os, signal, subprocess, sys, time

DEVICE = "/dev/video50"
POLL = 2
STOP_DELAY = 6

GST_ENV = os.environ.copy()
GST_ENV["GST_PLUGIN_PATH"] = "/usr/lib/gstreamer-1.0"

idle_proc = None
cam_proc = None


def start_idle():
    """Start black-frame writer using v4l2sink."""
    global idle_proc
    idle_proc = subprocess.Popen(
        ["gst-launch-1.0", "-q",
         "videotestsrc", "pattern=black",
         "!", "video/x-raw,format=NV12,width=1920,height=1080,framerate=1/1",
         "!", "v4l2sink", "device=" + DEVICE],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=GST_ENV,
    )


def stop_idle():
    """Stop idle writer."""
    global idle_proc
    if idle_proc:
        idle_proc.terminate()
        try:
            idle_proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            idle_proc.kill()
            idle_proc.wait()
        idle_proc = None


def start_camera():
    """Start real camera pipeline using v4l2sink."""
    global cam_proc
    cam_proc = subprocess.Popen(
        ["gst-launch-1.0", "-q",
         "icamerasrc", "device-name=ov08x40-uf",
         "sharpness=80", "ev=-1", "saturation=10",
         "!", "video/x-raw,format=NV12,width=1920,height=1080",
         "!", "videoflip", "method=rotate-180",
         "!", "v4l2sink", "device=" + DEVICE],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=GST_ENV,
    )


def stop_camera():
    """Stop real camera pipeline."""
    global cam_proc
    if cam_proc:
        cam_proc.terminate()
        try:
            cam_proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            cam_proc.kill()
            cam_proc.wait()
        cam_proc = None


def has_readers():
    """Check if any process besides ourselves is reading /dev/video50."""
    my_pid = os.getpid()
    try:
        r = subprocess.run(["fuser", DEVICE], capture_output=True, text=True, timeout=5)
        for pid_str in r.stdout.strip().split():
            pid_str = pid_str.strip()
            if not pid_str:
                continue
            pid = int(pid_str)
            if pid == my_pid:
                continue
            # Exclude our own child processes (idle_proc, cam_proc)
            if idle_proc and pid == idle_proc.pid:
                continue
            if cam_proc and pid == cam_proc.pid:
                continue
            return True
    except Exception:
        pass
    return False


def shutdown(sig, frame):
    stop_camera()
    stop_idle()
    sys.exit(0)


signal.signal(signal.SIGTERM, shutdown)
signal.signal(signal.SIGINT, shutdown)

# Start idle writer
start_idle()
time.sleep(1)

# Restart WirePlumber so it picks up the capture device
subprocess.run(["systemctl", "--user", "restart", "wireplumber.service"],
               capture_output=True, timeout=10)

active = False
idle_count = 0

while True:
    # Check if our subprocesses died unexpectedly
    if active and cam_proc and cam_proc.poll() is not None:
        # Camera process died — fall back to idle
        cam_proc = None
        active = False
        idle_count = 0
        start_idle()
    elif not active and idle_proc and idle_proc.poll() is not None:
        # Idle process died — restart it
        idle_proc = None
        start_idle()

    if has_readers():
        idle_count = 0
        if not active:
            stop_idle()
            time.sleep(0.2)
            start_camera()
            active = True
    else:
        if active:
            idle_count += 1
            if idle_count >= STOP_DELAY // POLL:
                stop_camera()
                time.sleep(0.2)
                start_idle()
                active = False
                idle_count = 0

    time.sleep(POLL)
